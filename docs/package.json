{
  "name": "@closure/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "mint dev --port ${CLOSURE_DOCS_PORT:-3236}",
    "poll": "node sync-openapi.ts",
    "start": "npm run poll -- --once && npm run preview",
    "validate": "mint validate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "devDependencies": {
    "mint": "^4.2.894",
    "vitest": "^4.1.11"
  }
}
