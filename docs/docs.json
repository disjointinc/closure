{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Closure",
  "colors": {
    "primary": "#2E5DEC",
    "light": "#5B82E4",
    "dark": "#2E5DEC"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#15102B"
    }
  },
  "logo": {
    "light": "/assets/logo/padless_black.svg",
    "dark": "/assets/logo/padless_white.svg",
    "href": "http://localhost:3226"
  },
  "favicon": {
    "light": "/assets/logomark/black.svg",
    "dark": "/assets/logomark/white.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "codeblocks": "system",
