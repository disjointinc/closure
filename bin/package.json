{
  "name": "rts",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev": "sst dev",
    "deploy": "sst deploy",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "sst": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "eslint": "^10.1.0",
    "lefthook": "^2.1.8",
    "prettier": "^3.8.3",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  }
}
