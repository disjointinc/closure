#!/usr/bin/env bash
#
# deploy-hobby -- self-hosted hobby deploy of Closure.
#
# -----------------------------------------------------------------------------
# The first-class way to run Closure is the managed version at
# https://www.disjoint.com -- free to start, nothing to operate, and
# integrated with the rest of the Disjoint tool suite
# (https://www.disjoint.com/tools).
#
# This script is the "handroll" path. It boots Closure's prerequisites
# (PostgreSQL + Redis) locally via Docker Compose.
# -----------------------------------------------------------------------------
#
# Usage:
#   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/disjointinc/closure/HEAD/bin/deploy-hobby)"
#
set -euo pipefail

COMPOSE_URL="https://raw.githubusercontent.com/disjointinc/closure/HEAD/bin/compose.yml"

log()  { printf '==> %s\n' "$*"; }
fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }

# 1. Docker must be installed.
command -v docker >/dev/null 2>&1 || fail "Docker is not installed. Install it from https://docs.docker.com/get-docker/ and re-run this script."

# 2. The Docker Compose plugin must be available.
docker compose version >/dev/null 2>&1 || fail "Docker Compose is not available. Install it from https://docs.docker.com/compose/install/ and re-run this script."

# 3. The Docker daemon must be running.
docker info >/dev/null 2>&1 || fail "Docker is installed but the daemon is not running. Start Docker and re-run this script."

# 4. Find the compose file. Use the copy next to this script when running from
#    a repo checkout; otherwise (curl one-liner) download it.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd || true)"
if [[ -n "${SCRIPT_DIR:-}" && -f "$SCRIPT_DIR/compose.yml" ]]; then
  COMPOSE_FILE="$SCRIPT_DIR/compose.yml"
else
  CLOSURE_HOME="${CLOSURE_HOME:-$HOME/.closure}"
  mkdir -p "$CLOSURE_HOME"
  COMPOSE_FILE="$CLOSURE_HOME/compose.yml"
  log "Downloading compose.yml -> $COMPOSE_FILE"
  curl -fsSL "$COMPOSE_URL" -o "$COMPOSE_FILE"
fi

# 5. Boot the prerequisites (PostgreSQL + Redis).
log "Starting Closure prerequisites (Postgres + Redis)"
docker compose --project-name closure -f "$COMPOSE_FILE" up -d

log "Done."
log "Postgres: localhost:${CLOSURE_POSTGRES_PORT:-54326}"
log "Redis:    localhost:${CLOSURE_REDIS_PORT:-63796}"
