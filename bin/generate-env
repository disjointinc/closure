#!/usr/bin/env bash
#
# generate-env -- give every password and key Closure needs a value in the
# .env file next to this script, which Docker Compose and config.ts both read.
# Values already in .env (or set in the shell) are kept; the rest get random
# ones. Safe to rerun: it never changes a value that's already there.
#
# Usage: bin/generate-env
#
set -euo pipefail

ENV_FILE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/.env"
touch "$ENV_FILE"
chmod 600 "$ENV_FILE"

# 16 random bytes as 32 lowercase hex characters: safe inside web addresses,
# which some services put passwords in.
random_hex() { od -An -tx1 -N16 /dev/urandom | tr -d ' \n'; }
# 32 random bytes, base64: the size the encryption keys need.
random_key() { head -c 32 /dev/urandom | base64 | tr -d '\n'; }

# ensure_setting NAME VALUE: add NAME=VALUE to .env unless NAME is already set.
ensure_setting() {
  local name="$1" value="$2"
  if [[ -n "${!name:-}" ]] || grep -q "^${name}=" "$ENV_FILE"; then
    return
  fi
  printf '%s=%s\n' "$name" "$value" >> "$ENV_FILE"
}

uuid_hex="$(random_hex)"
ensure_setting CLOSURE_POSTGRES_PASSWORD "$(random_hex)"
ensure_setting CLOSURE_REDIS_PASSWORD "$(random_hex)"
ensure_setting CLOSURE_SECRETS_KEY "$(random_key)"
ensure_setting CLOSURE_NANGO_ENCRYPTION_KEY "$(random_key)"
ensure_setting CLOSURE_NANGO_SECRET_KEY \
  "${uuid_hex:0:8}-${uuid_hex:8:4}-4${uuid_hex:13:3}-8${uuid_hex:17:3}-${uuid_hex:20:12}"
ensure_setting CLOSURE_NANGO_DASHBOARD_PASSWORD "$(random_hex)"
# Hatchet requires an uppercase letter, a lowercase letter, and a number.
# Hex never has an uppercase letter, so prefix one of each.
ensure_setting CLOSURE_HATCHET_DASHBOARD_PASSWORD "Ab1$(random_hex)"

printf '==> Passwords and keys: %s\n' "$ENV_FILE"
